{
  "name": "chessduo-stockfish-server",
  "version": "1.0.0",
  "description": "Server-side Stockfish evaluation API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src", "<rootDir>/__tests__"],
    "moduleFileExtensions": ["ts", "js"]
  },
  "dependencies": {
    "chess.js": "^1.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lru-cache": "^11.2.7",
    "stockfish": "^16.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
