# ── Required (must be set before building APK/AAB) ──────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_STOCKFISH_SERVER_URL=https://your-stockfish-server.onrender.com
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-oauth-client-id

# ── Razorpay (Premium Subscriptions) ──────────────────
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are server-side only.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe for client (checkout modal).
# Plan IDs come from Razorpay Dashboard → Plans → Plan ID column.
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyid
NEXT_PUBLIC_RAZORPAY_PLAN_MONTHLY=plan_yourmonthlyplanid
NEXT_PUBLIC_RAZORPAY_PLAN_ANNUAL=plan_yourannualplanid
NEXT_PUBLIC_SITE_URL=https://chessduo.your-account.workers.dev

# Copy this file to .env.production and fill in real values:
#   cp .env.example .env.production
# The build scripts (build-apk.sh / build-aab.sh) load .env.production automatically.

#
# ── Cloudflare Workers (when deploying via opennextjs-cloudflare) ──
# Set these as secrets in Cloudflare Dashboard (Workers → chessduo → Settings → Variables)
# or via `npx wrangler secret put <KEY>`:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_STOCKFISH_SERVER_URL
#   NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID
