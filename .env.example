# ── Premium subscription (Google Play Billing) ──────
# Set to "true" while waiting for Google Play approval.
# Removes purchase CTAs and shows "Coming Soon" messaging.
# Remove or set to "false" after approval to enable purchases.
# NEXT_PUBLIC_PREMIUM_COMING_SOON=true

# ── Required (must be set before building APK/AAB) ──────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-oauth-client-id
NEXT_PUBLIC_SITE_URL=https://chessduo.your-account.workers.dev

# App version reported in error/crash reports (P0-2). Set at build time.
# NEXT_PUBLIC_APP_VERSION=1.0.328

# Enable Realtime diagnostics (P0-3) — exposes window.__chessDuoRealtime.
# NEXT_PUBLIC_CHESSDUO_DIAGNOSTICS=true

# Enable game-lifecycle tracing (P1 black-bot investigation) — emits
# GAME_TRACE events to console + window.__chessDuoTrace and /api/log-crash.
# NEXT_PUBLIC_CHESSDUO_TRACE=true

# ── Web Push (Browser Push Notifications) ──────
# Generate VAPID keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@chessduo.app
# Set VAPID_PRIVATE_KEY as Cloudflare secret (not in .env files for local dev).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe as a public env var (used in the browser).

# ── Firebase Cloud Messaging (Android Push Notifications) ──────
# FCM_SERVICE_ACCOUNT_JSON is the full service account JSON (minified, single line).
# Set as Cloudflare secret (not in .env files for local dev).
# FCM_PROJECT_ID = Firebase project ID (also in the service account JSON).
# These are set via wrangler secrets or GitHub Actions secrets, not in .env.
# Local dev: you can set these in .dev.vars for testing.

# ── Supabase Service Role Key (server-side RLS bypass) ──────
# Required for push notifications and API routes that need to query
# other users' data. Found in your Supabase dashboard → Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set as Cloudflare secret and GitHub secret (not in client-side .env files).

# Copy this file to .env.production and fill in real values:
#   cp .env.example .env.production
# The build scripts (build-apk.sh / build-aab.sh) load .env.production automatically.

#
# ── Cloudflare Workers (when deploying via opennextjs-cloudflare) ──
# Set these as secrets in Cloudflare Dashboard (Workers → chessduo → Settings → Variables)
# or via `npx wrangler secret put <KEY>`:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID
